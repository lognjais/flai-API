# Required — the shared password. Session tokens are HMAC'd with it, so changing this
# invalidates every outstanding token.
PASS=change-me

# How long a token lasts. Tokens ride in the query string for <video> and EventSource, so
# they expire; 12 hours is a working day.
SESSION_TTL_HOURS=12

# Comma-separated. Add your frontend origin(s).
ALLOWED_ORIGINS=https://jvoltci.github.io,https://flai.ivehement.com,http://localhost:5173

# ── the memory bound ─────────────────────────────────────────────────────────
# Sized for a 512 MB box, from a measured full 129 MB download rather than arithmetic.
#
# READ_WINDOW_BYTES is the real bound: routes/stream.js reads a file as a sequence of windows
# this size, and webtorrent only ever selects the pieces one open read covers. Responses stay
# ordinary and full-length, so a plain browser download works.
#
# WINDOW_BUDGET_BYTES is the store, and the store is a cache — it fills whatever you give it.
# At 64 MB it sat at 67 MB resident and peaked at 233 MB RSS for a single stream, too much to
# spend twice on this box. 32 MB is 2x the read window, which is all the slack that is needed.
MAX_ACTIVE_TORRENTS=2
READ_WINDOW_BYTES=16777216
WINDOW_BUDGET_BYTES=33554432
MAX_CONNS=100

# How long an untouched torrent lives before its window is freed.
TORRENT_IDLE_EVICT_MS=300000
METADATA_TIMEOUT_MS=60000

# On macOS, AirPlay Receiver (ControlCenter) already listens on 5000 and answers 403 to
# everything, which looks exactly like a broken CORS config. Use another port locally, or turn
# AirPlay Receiver off in System Settings → General → AirDrop & Handoff.
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
