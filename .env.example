# Required — shared secret used by the frontend to authorize torrent fetches.
PASS=change-me

# Optional — falls back to in-memory store if unset/unreachable, so /metadata + /torrent still work.
DATABASE=mongodb://localhost:27017
DATABASE_NAME=flaiDB

# Comma-separated list. Add your frontend origin(s).
ALLOWED_ORIGINS=https://jvoltci.github.io,http://localhost:5173

# Set to your deployed URL to enable the keep-warm self-ping (Render free tier).
PUBLIC_URL=https://flai-api.onrender.com
KEEP_WARM_INTERVAL_MS=600000

PORT=5000
NODE_ENV=development
LOG_LEVEL=info
